{
  "name": "erp-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API del ERP para pequeñas tiendas",
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.6.1",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "nest start --watch --config config/nest-cli.json",
    "build": "nest build --config config/nest-cli.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --config config/eslint.config.js --max-warnings=0",
    "format": "prettier --write src test config package.json tsconfig.json --ignore-path .gitignore",
    "format:check": "prettier --check src test config package.json tsconfig.json --ignore-path .gitignore",
    "test": "jest --config config/jest.config.js --runInBand",
    "test:integration": "jest --config config/jest.integration.config.js --runInBand",
    "prisma:generate": "prisma generate --config config/prisma.config.ts",
    "prisma:validate": "prisma validate --config config/prisma.config.ts",
    "db:migrate": "prisma migrate dev --config config/prisma.config.ts",
    "db:deploy": "prisma migrate deploy --config config/prisma.config.ts",
    "db:deploy:test": "prisma migrate deploy --config config/prisma.test.config.ts",
    "db:status": "prisma migrate status --config config/prisma.config.ts",
    "db:seed": "npm run build && node dist/cli/seed-demo.js",
    "db:backup": "node scripts/db-tools.js backup",
    "db:restore": "node scripts/db-tools.js restore",
    "db:backup:verify": "node scripts/db-tools.js verify"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "endOfLine": "lf"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.44.0",
    "dotenv": "^17.2.3",
    "exceljs": "4.4.0",
    "helmet": "^8.1.0",
    "nodemailer": "7.0.13",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "11.2.8",
    "@types/express": "^5.0.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "7.0.12",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "prisma": "7.10.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
