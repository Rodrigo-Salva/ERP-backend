# Valores exclusivamente para desarrollo local.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true
SESSION_TTL_HOURS=8
APP_URL=http://localhost:5173
MAIL_TRANSPORT=local
MAIL_FROM=erp@example.test
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=usuario
# SMTP_PASSWORD=contraseña
# Crear el rol y las bases en PostgreSQL local; ajustar usuario y contraseña.
DATABASE_URL=postgresql://erp:erp_local_only@localhost:5432/erp_dev
# Base independiente para pruebas de integración. No usar datos reales.
TEST_DATABASE_URL=postgresql://erp:erp_local_only@localhost:5432/erp_test
# Opcional para crear nuevas migraciones con un rol sin permiso CREATEDB.
# SHADOW_DATABASE_URL=postgresql://erp:erp_local_only@localhost:5432/erp_shadow

