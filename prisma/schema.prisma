generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation("PasswordReset_userId_fkey", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "PasswordReset_userId_fkey")

  @@index([userId])
}

model Invitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  email          String       @db.VarChar(254)
  role           Role
  allBranches    Boolean      @default(false)
  branchIds      String[]
  permissions    String[]
  tokenHash      String       @unique @db.Char(64)
  invitedBy      String       @db.Uuid
  expiresAt      DateTime     @db.Timestamptz(3)
  usedAt         DateTime?    @db.Timestamptz(3)
  revokedAt      DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  organization   Organization @relation("Invitation_organizationId_fkey", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "Invitation_organizationId_fkey")
  inviter        User         @relation("Invitation_invitedBy_fkey", fields: [invitedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "Invitation_invitedBy_fkey")

  @@index([organizationId, email])
}

model IdempotencyRecord {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  actorId        String       @db.Uuid
  operation      String       @db.VarChar(120)
  key            String       @db.VarChar(100)
  fingerprint    String       @db.Char(64)
  response       Json
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  organization   Organization @relation("IdempotencyRecord_organizationId_fkey", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "IdempotencyRecord_organizationId_fkey")
  actor          User         @relation("IdempotencyRecord_actorId_fkey", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "IdempotencyRecord_actorId_fkey")

  @@unique([organizationId, operation, key])
}

model Supplier {
  id                     String          @id @default(uuid()) @db.Uuid
  organizationId         String          @db.Uuid
  name                   String          @db.VarChar(160)
  email                  String?         @db.VarChar(254)
  phone                  String?         @db.VarChar(40)
  address                String?         @db.VarChar(300)
  archivedAt             DateTime?       @db.Timestamptz(3)
  createdAt              DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @db.Timestamptz(3)
  organization           Organization    @relation("Supplier_organizationId_fkey", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "Supplier_organizationId_fkey")
  purchaseOrder_supplier PurchaseOrder[] @relation("PurchaseOrder_supplier_fkey")

  @@unique([organizationId, id])
  @@index([organizationId, name])
}

model Customer {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String       @db.VarChar(160)
  email          String?      @db.VarChar(254)
  phone          String?      @db.VarChar(40)
  consentAt      DateTime     @db.Timestamptz(3)
  archivedAt     DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  organization   Organization @relation("Customer_organizationId_fkey", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "Customer_organizationId_fkey")
  sale_customer  Sale[]       @relation("Sale_customer_fkey")

  @@unique([organizationId, id])
  @@index([organizationId, name])
}

model InventoryBalance {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  branchId       String         @db.Uuid
  warehouseId    String         @db.Uuid
  variantId      String         @db.Uuid
  quantity       Decimal        @default(0) @db.Decimal(18, 3)
  value          Decimal        @default(0) @db.Decimal(30, 7)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  warehouse      Warehouse      @relation("InventoryBalance_warehouse_fkey", fields: [organizationId, branchId, warehouseId], references: [organizationId, branchId, id], onDelete: Restrict, onUpdate: Restrict, map: "InventoryBalance_warehouse_fkey")
  variant        ProductVariant @relation("InventoryBalance_variant_fkey", fields: [organizationId, variantId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "InventoryBalance_variant_fkey")

  @@unique([organizationId, warehouseId, variantId])
  @@index([organizationId, branchId])
}

model InventoryMovement {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  branchId       String         @db.Uuid
  warehouseId    String         @db.Uuid
  variantId      String         @db.Uuid
  actorId        String         @db.Uuid
  kind           String         @db.VarChar(40)
  referenceId    String         @db.Uuid
  reason         String         @db.VarChar(300)
  delta          Decimal        @db.Decimal(18, 3)
  before         Decimal        @db.Decimal(18, 3)
  after          Decimal        @db.Decimal(18, 3)
  unitCost       Decimal        @db.Decimal(26, 7)
  valueDelta     Decimal        @db.Decimal(30, 7)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  warehouse      Warehouse      @relation("InventoryMovement_warehouse_fkey", fields: [organizationId, branchId, warehouseId], references: [organizationId, branchId, id], onDelete: Restrict, onUpdate: Restrict, map: "InventoryMovement_warehouse_fkey")
  variant        ProductVariant @relation("InventoryMovement_variant_fkey", fields: [organizationId, variantId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "InventoryMovement_variant_fkey")
  actor          User           @relation("InventoryMovement_actorId_fkey", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "InventoryMovement_actorId_fkey")

  @@index([organizationId, branchId, createdAt])
  @@index([organizationId, referenceId])
}

model PurchaseOrder {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @db.Uuid
  branchId           String              @db.Uuid
  warehouseId        String              @db.Uuid
  supplierId         String              @db.Uuid
  actorId            String              @db.Uuid
  status             String              @default("DRAFT") @db.VarChar(20)
  notes              String?             @db.VarChar(2000)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  lines              PurchaseOrderLine[]
  warehouse          Warehouse           @relation("PurchaseOrder_warehouse_fkey", fields: [organizationId, branchId, warehouseId], references: [organizationId, branchId, id], onDelete: Restrict, onUpdate: Restrict, map: "PurchaseOrder_warehouse_fkey")
  supplier           Supplier            @relation("PurchaseOrder_supplier_fkey", fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "PurchaseOrder_supplier_fkey")
  actor              User                @relation("PurchaseOrder_actorId_fkey", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "PurchaseOrder_actorId_fkey")
  goodsReceipt_order GoodsReceipt[]      @relation("GoodsReceipt_order_fkey")

  @@unique([organizationId, id])
  @@index([organizationId, branchId, createdAt])
}

model PurchaseOrderLine {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  purchaseOrderId String         @db.Uuid
  variantId       String         @db.Uuid
  quantity        Decimal        @db.Decimal(18, 3)
  received        Decimal        @default(0) @db.Decimal(18, 3)
  unitCost        Decimal        @db.Decimal(18, 4)
  order           PurchaseOrder  @relation(fields: [organizationId, purchaseOrderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  variant         ProductVariant @relation("PurchaseOrderLine_variant_fkey", fields: [organizationId, variantId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "PurchaseOrderLine_variant_fkey")

  @@unique([organizationId, id])
  @@unique([organizationId, purchaseOrderId, variantId])
}

model GoodsReceipt {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @db.Uuid
  branchId        String        @db.Uuid
  purchaseOrderId String        @db.Uuid
  actorId         String        @db.Uuid
  lines           Json
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  order           PurchaseOrder @relation("GoodsReceipt_order_fkey", fields: [organizationId, purchaseOrderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "GoodsReceipt_order_fkey")
  branch          Branch        @relation("GoodsReceipt_branch_fkey", fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "GoodsReceipt_branch_fkey")
  actor           User          @relation("GoodsReceipt_actorId_fkey", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "GoodsReceipt_actorId_fkey")

  @@index([organizationId, branchId, createdAt])
}

model InventoryTransfer {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @db.Uuid
  branchId          String    @db.Uuid
  targetBranchId    String    @db.Uuid
  sourceWarehouseId String    @db.Uuid
  targetWarehouseId String    @db.Uuid
  actorId           String    @db.Uuid
  status            String    @default("DRAFT") @db.VarChar(20)
  reason            String    @db.VarChar(300)
  lines             Json
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
  source            Warehouse @relation("InventoryTransfer_source_fkey", fields: [organizationId, branchId, sourceWarehouseId], references: [organizationId, branchId, id], onDelete: Restrict, onUpdate: Restrict, map: "InventoryTransfer_source_fkey")
  target            Warehouse @relation("InventoryTransfer_target_fkey", fields: [organizationId, targetBranchId, targetWarehouseId], references: [organizationId, branchId, id], onDelete: Restrict, onUpdate: Restrict, map: "InventoryTransfer_target_fkey")
  actor             User      @relation("InventoryTransfer_actorId_fkey", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "InventoryTransfer_actorId_fkey")

  @@unique([organizationId, id])
  @@index([organizationId, branchId, targetBranchId])
}

model PaymentMethod {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @db.Uuid
  code              String       @db.VarChar(30)
  name              String       @db.VarChar(80)
  isCash            Boolean      @default(false)
  archivedAt        DateTime?    @db.Timestamptz(3)
  organization      Organization @relation("PaymentMethod_organizationId_fkey", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "PaymentMethod_organizationId_fkey")
  payment_method    Payment[]    @relation("Payment_method_fkey")
  saleReturn_method SaleReturn[] @relation("SaleReturn_method_fkey")

  @@unique([organizationId, id])
  @@unique([organizationId, code])
}

model ExpenseCategory {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @db.Uuid
  name             String       @db.VarChar(100)
  archivedAt       DateTime?    @db.Timestamptz(3)
  organization     Organization @relation("ExpenseCategory_organizationId_fkey", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "ExpenseCategory_organizationId_fkey")
  expense_category Expense[]    @relation("Expense_category_fkey")

  @@unique([organizationId, id])
  @@unique([organizationId, name])
}

model CashRegister {
  id                    String        @id @default(uuid()) @db.Uuid
  organizationId        String        @db.Uuid
  branchId              String        @db.Uuid
  name                  String        @db.VarChar(80)
  archivedAt            DateTime?     @db.Timestamptz(3)
  organizationId_branch Branch        @relation("CashRegister_organizationId_branchId_fkey", fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "CashRegister_organizationId_branchId_fkey")
  cashSession_register  CashSession[] @relation("CashSession_register_fkey")

  @@unique([organizationId, id])
  @@unique([organizationId, branchId, name])
}

model CashSession {
  id                   String         @id @default(uuid()) @db.Uuid
  organizationId       String         @db.Uuid
  branchId             String         @db.Uuid
  cashRegisterId       String         @db.Uuid
  actorId              String         @db.Uuid
  opening              Decimal        @db.Decimal(18, 4)
  expected             Decimal?       @db.Decimal(18, 4)
  counted              Decimal?       @db.Decimal(18, 4)
  difference           Decimal?       @db.Decimal(18, 4)
  closedBy             String?        @db.Uuid
  closedAt             DateTime?      @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  register             CashRegister   @relation("CashSession_register_fkey", fields: [organizationId, cashRegisterId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "CashSession_register_fkey")
  branch               Branch         @relation("CashSession_branch_fkey", fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "CashSession_branch_fkey")
  actor                User           @relation("CashSession_actorId_fkey", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "CashSession_actorId_fkey")
  closer               User?          @relation("CashSession_closedBy_fkey", fields: [closedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "CashSession_closedBy_fkey")
  cashMovement_session CashMovement[] @relation("CashMovement_session_fkey")
  sale_session         Sale[]         @relation("Sale_session_fkey")
  saleReturn_session   SaleReturn[]   @relation("SaleReturn_session_fkey")
  expense_session      Expense[]      @relation("Expense_session_fkey")

  @@unique([organizationId, id])
  @@index([organizationId, branchId, createdAt])
}

model CashMovement {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  branchId       String      @db.Uuid
  cashSessionId  String      @db.Uuid
  actorId        String      @db.Uuid
  amount         Decimal     @db.Decimal(18, 4)
  kind           String      @db.VarChar(30)
  reason         String      @db.VarChar(300)
  referenceId    String      @db.Uuid
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  session        CashSession @relation("CashMovement_session_fkey", fields: [organizationId, cashSessionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "CashMovement_session_fkey")
  actor          User        @relation("CashMovement_actorId_fkey", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "CashMovement_actorId_fkey")

  @@index([organizationId, cashSessionId, createdAt])
}

model Sale {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  branchId        String       @db.Uuid
  warehouseId     String       @db.Uuid
  cashSessionId   String       @db.Uuid
  customerId      String?      @db.Uuid
  actorId         String       @db.Uuid
  folio           String?      @db.VarChar(50)
  status          String       @default("DRAFT") @db.VarChar(20)
  currency        String       @db.Char(3)
  moneyPrecision  Int
  taxRate         Decimal      @db.Decimal(7, 4)
  taxIncluded     Boolean
  gross           Decimal      @default(0) @db.Decimal(18, 4)
  discount        Decimal      @default(0) @db.Decimal(18, 4)
  tax             Decimal      @default(0) @db.Decimal(18, 4)
  total           Decimal      @default(0) @db.Decimal(18, 4)
  change          Decimal      @default(0) @db.Decimal(18, 4)
  storeSnapshot   Json
  confirmedAt     DateTime?    @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  lines           SaleLine[]
  payments        Payment[]
  warehouse       Warehouse    @relation("Sale_warehouse_fkey", fields: [organizationId, branchId, warehouseId], references: [organizationId, branchId, id], onDelete: Restrict, onUpdate: Restrict, map: "Sale_warehouse_fkey")
  session         CashSession  @relation("Sale_session_fkey", fields: [organizationId, cashSessionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "Sale_session_fkey")
  customer        Customer?    @relation("Sale_customer_fkey", fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "Sale_customer_fkey")
  actor           User         @relation("Sale_actorId_fkey", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "Sale_actorId_fkey")
  saleReturn_sale SaleReturn[] @relation("SaleReturn_sale_fkey")

  @@unique([organizationId, id])
  @@unique([organizationId, folio])
  @@index([organizationId, branchId, createdAt])
}

model SaleLine {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  saleId         String         @db.Uuid
  variantId      String         @db.Uuid
  sku            String         @db.VarChar(64)
  name           String         @db.VarChar(300)
  quantity       Decimal        @db.Decimal(18, 3)
  returned       Decimal        @default(0) @db.Decimal(18, 3)
  price          Decimal        @db.Decimal(18, 4)
  cost           Decimal        @default(0) @db.Decimal(26, 7)
  discountRate   Decimal        @db.Decimal(7, 4)
  gross          Decimal        @db.Decimal(18, 4)
  discount       Decimal        @db.Decimal(18, 4)
  tax            Decimal        @db.Decimal(18, 4)
  total          Decimal        @db.Decimal(18, 4)
  sale           Sale           @relation(fields: [organizationId, saleId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  variant        ProductVariant @relation("SaleLine_variant_fkey", fields: [organizationId, variantId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "SaleLine_variant_fkey")

  @@unique([organizationId, id])
  @@unique([organizationId, saleId, variantId])
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  saleId         String        @db.Uuid
  methodId       String        @db.Uuid
  methodName     String        @db.VarChar(80)
  isCash         Boolean
  amount         Decimal       @db.Decimal(18, 4)
  sale           Sale          @relation(fields: [organizationId, saleId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  method         PaymentMethod @relation("Payment_method_fkey", fields: [organizationId, methodId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "Payment_method_fkey")

  @@index([organizationId, saleId])
}

model SaleReturn {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  branchId       String        @db.Uuid
  saleId         String        @db.Uuid
  cashSessionId  String?       @db.Uuid
  actorId        String        @db.Uuid
  methodId       String        @db.Uuid
  reason         String        @db.VarChar(300)
  lines          Json
  gross          Decimal       @db.Decimal(18, 4)
  discount       Decimal       @db.Decimal(18, 4)
  tax            Decimal       @db.Decimal(18, 4)
  total          Decimal       @db.Decimal(18, 4)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  sale           Sale          @relation("SaleReturn_sale_fkey", fields: [organizationId, saleId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "SaleReturn_sale_fkey")
  session        CashSession?  @relation("SaleReturn_session_fkey", fields: [organizationId, cashSessionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "SaleReturn_session_fkey")
  method         PaymentMethod @relation("SaleReturn_method_fkey", fields: [organizationId, methodId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "SaleReturn_method_fkey")
  actor          User          @relation("SaleReturn_actorId_fkey", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "SaleReturn_actorId_fkey")

  @@index([organizationId, branchId, createdAt])
  @@index([organizationId, saleId])
}

model Expense {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  branchId       String          @db.Uuid
  categoryId     String          @db.Uuid
  actorId        String          @db.Uuid
  cashSessionId  String?         @db.Uuid
  amount         Decimal         @db.Decimal(18, 4)
  description    String          @db.VarChar(300)
  occurredAt     DateTime        @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  branch         Branch          @relation("Expense_branch_fkey", fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "Expense_branch_fkey")
  category       ExpenseCategory @relation("Expense_category_fkey", fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "Expense_category_fkey")
  session        CashSession?    @relation("Expense_session_fkey", fields: [organizationId, cashSessionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "Expense_session_fkey")
  actor          User            @relation("Expense_actorId_fkey", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "Expense_actorId_fkey")

  @@index([organizationId, branchId, occurredAt])
}

model DocumentCounter {
  organizationId String       @db.Uuid
  namespace      String       @db.VarChar(20)
  value          Int          @default(0)
  organization   Organization @relation("DocumentCounter_organizationId_fkey", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "DocumentCounter_organizationId_fkey")

  @@id([organizationId, namespace])
}

model Organization {
  moneyPrecision                 Int                 @default(2)
  taxRate                        Decimal             @default(0) @db.Decimal(7, 4)
  taxIncluded                    Boolean             @default(false)
  discountLimit                  Decimal             @default(0) @db.Decimal(7, 4)
  allowNegativeStock             Boolean             @default(false)
  receiptPrefix                  String              @default("V") @db.VarChar(12)
  id                             String              @id @default(uuid()) @db.Uuid
  name                           String              @db.VarChar(160)
  currency                       String              @db.Char(3)
  locale                         String              @db.VarChar(35)
  timeZone                       String              @db.VarChar(80)
  createdAt                      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt                      DateTime            @updatedAt @db.Timestamptz(3)
  archivedAt                     DateTime?           @db.Timestamptz(3)
  branches                       Branch[]
  auditEvents                    AuditEvent[]
  memberships                    Membership[]
  categories                     Category[]
  units                          UnitOfMeasure[]
  products                       Product[]
  invitation_organization        Invitation[]        @relation("Invitation_organizationId_fkey")
  idempotencyRecord_organization IdempotencyRecord[] @relation("IdempotencyRecord_organizationId_fkey")
  documentCounter_organization   DocumentCounter[]   @relation("DocumentCounter_organizationId_fkey")
  supplier_organization          Supplier[]          @relation("Supplier_organizationId_fkey")
  customer_organization          Customer[]          @relation("Customer_organizationId_fkey")
  paymentMethod_organization     PaymentMethod[]     @relation("PaymentMethod_organizationId_fkey")
  expenseCategory_organization   ExpenseCategory[]   @relation("ExpenseCategory_organizationId_fkey")
}

model Branch {
  id                                 String             @id @default(uuid()) @db.Uuid
  organizationId                     String             @db.Uuid
  name                               String             @db.VarChar(160)
  code                               String             @db.VarChar(40)
  address                            String?            @db.VarChar(300)
  timeZone                           String             @db.VarChar(80)
  createdAt                          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt                          DateTime           @updatedAt @db.Timestamptz(3)
  archivedAt                         DateTime?          @db.Timestamptz(3)
  organization                       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  warehouses                         Warehouse[]
  accessGrants                       MembershipBranch[]
  cashRegister_organizationId_branch CashRegister[]     @relation("CashRegister_organizationId_branchId_fkey")
  goodsReceipt_branch                GoodsReceipt[]     @relation("GoodsReceipt_branch_fkey")
  cashSession_branch                 CashSession[]      @relation("CashSession_branch_fkey")
  expense_branch                     Expense[]          @relation("Expense_branch_fkey")

  @@unique([organizationId, id])
  @@unique([organizationId, code])
}

model Warehouse {
  id                          String              @id @default(uuid()) @db.Uuid
  organizationId              String              @db.Uuid
  branchId                    String              @db.Uuid
  name                        String              @db.VarChar(160)
  code                        String              @db.VarChar(40)
  createdAt                   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime            @updatedAt @db.Timestamptz(3)
  archivedAt                  DateTime?           @db.Timestamptz(3)
  branch                      Branch              @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  inventoryBalance_warehouse  InventoryBalance[]  @relation("InventoryBalance_warehouse_fkey")
  inventoryMovement_warehouse InventoryMovement[] @relation("InventoryMovement_warehouse_fkey")
  inventoryTransfer_source    InventoryTransfer[] @relation("InventoryTransfer_source_fkey")
  inventoryTransfer_target    InventoryTransfer[] @relation("InventoryTransfer_target_fkey")
  purchaseOrder_warehouse     PurchaseOrder[]     @relation("PurchaseOrder_warehouse_fkey")
  sale_warehouse              Sale[]              @relation("Sale_warehouse_fkey")

  @@unique([organizationId, branchId, id])
  @@unique([organizationId, branchId, code])
}

// Los eventos se escribirán dentro de la transacción de la operación sensible.
model AuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  actorId        String?      @db.Uuid
  action         String       @db.VarChar(100)
  resourceType   String       @db.VarChar(80)
  resourceId     String       @db.VarChar(100)
  requestId      String       @db.Uuid
  changes        Json?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, createdAt])
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  CASHIER
  VIEWER
}

model User {
  id                      String              @id @default(uuid()) @db.Uuid
  email                   String              @unique @db.VarChar(254)
  name                    String              @db.VarChar(120)
  passwordHash            String              @db.VarChar(255)
  createdAt               DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime            @updatedAt @db.Timestamptz(3)
  disabledAt              DateTime?           @db.Timestamptz(3)
  memberships             Membership[]
  sessions                Session[]
  auditEvents             AuditEvent[]
  passwordReset_user      PasswordReset[]     @relation("PasswordReset_userId_fkey")
  invitation_inviter      Invitation[]        @relation("Invitation_invitedBy_fkey")
  idempotencyRecord_actor IdempotencyRecord[] @relation("IdempotencyRecord_actorId_fkey")
  inventoryMovement_actor InventoryMovement[] @relation("InventoryMovement_actorId_fkey")
  inventoryTransfer_actor InventoryTransfer[] @relation("InventoryTransfer_actorId_fkey")
  purchaseOrder_actor     PurchaseOrder[]     @relation("PurchaseOrder_actorId_fkey")
  goodsReceipt_actor      GoodsReceipt[]      @relation("GoodsReceipt_actorId_fkey")
  cashSession_actor       CashSession[]       @relation("CashSession_actorId_fkey")
  cashSession_closer      CashSession[]       @relation("CashSession_closedBy_fkey")
  cashMovement_actor      CashMovement[]      @relation("CashMovement_actorId_fkey")
  sale_actor              Sale[]              @relation("Sale_actorId_fkey")
  saleReturn_actor        SaleReturn[]        @relation("SaleReturn_actorId_fkey")
  expense_actor           Expense[]           @relation("Expense_actorId_fkey")
}

model Membership {
  permissions    String[]           @default([])
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  userId         String             @db.Uuid
  role           Role
  allBranches    Boolean            @default(false)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)
  revokedAt      DateTime?          @db.Timestamptz(3)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user           User               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branches       MembershipBranch[]

  @@unique([organizationId, id])
  @@unique([organizationId, userId])
  @@index([userId])
}

model MembershipBranch {
  organizationId String     @db.Uuid
  membershipId   String     @db.Uuid
  branchId       String     @db.Uuid
  membership     Membership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  branch         Branch     @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([organizationId, membershipId, branchId])
  @@index([organizationId, branchId])
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Category {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String       @db.VarChar(120)
  nameKey        String       @db.VarChar(240)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  archivedAt     DateTime?    @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  products       Product[]

  @@unique([organizationId, id])
  @@unique([organizationId, nameKey])
}

model UnitOfMeasure {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  code           String       @db.VarChar(20)
  name           String       @db.VarChar(80)
  precision      Int          @default(0)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  archivedAt     DateTime?    @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  products       Product[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
}

model Product {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @db.Uuid
  name              String           @db.VarChar(160)
  description       String?          @db.VarChar(2000)
  categoryId        String?          @db.Uuid
  unitId            String           @db.Uuid
  lowStockThreshold Decimal          @default(0) @db.Decimal(18, 3)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)
  archivedAt        DateTime?        @db.Timestamptz(3)
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category          Category?        @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  unit              UnitOfMeasure    @relation(fields: [organizationId, unitId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  variants          ProductVariant[]

  @@unique([organizationId, id])
  @@index([organizationId, archivedAt, name])
  @@index([organizationId, categoryId])
  @@index([organizationId, unitId])
}

model ProductVariant {
  name                      String              @default("Principal") @db.VarChar(120)
  archivedAt                DateTime?           @db.Timestamptz(3)
  id                        String              @id @default(uuid()) @db.Uuid
  organizationId            String              @db.Uuid
  productId                 String              @db.Uuid
  isDefault                 Boolean             @default(true)
  sku                       String              @db.VarChar(64)
  barcode                   String?             @db.VarChar(64)
  cost                      Decimal             @db.Decimal(18, 4)
  price                     Decimal             @db.Decimal(18, 4)
  createdAt                 DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime            @updatedAt @db.Timestamptz(3)
  product                   Product             @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  inventoryBalance_variant  InventoryBalance[]  @relation("InventoryBalance_variant_fkey")
  inventoryMovement_variant InventoryMovement[] @relation("InventoryMovement_variant_fkey")
  purchaseOrderLine_variant PurchaseOrderLine[] @relation("PurchaseOrderLine_variant_fkey")
  saleLine_variant          SaleLine[]          @relation("SaleLine_variant_fkey")

  // Un índice parcial en la migración permite como máximo una variante predeterminada.
  @@unique([organizationId, id])
  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId, productId])
}
